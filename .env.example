# ============================================================
# Amapola Haircare — Variables de Entorno
# Copiar este archivo a .env y completar con los valores reales
# NUNCA commitear el archivo .env
# ============================================================

# App
APP_URL="http://localhost:3000"

# ── Supabase ─────────────────────────────────────────────────
# Prefijo VITE_ → accesibles en el frontend React
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Sin prefijo → EXCLUSIVAMENTE server-side (Express). NUNCA exponer al frontend.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Stripe (pagos España — soporta tarjeta + Bizum + PSD2/SCA) ──
# Prefijo VITE_ → para inicializar Stripe.js en el frontend
VITE_STRIPE_PUBLISHABLE_KEY=""

# Sin prefijo → server-side únicamente
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Resend (email transaccional + PDF adjunto) ────────────────
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""         # ej: hola@amapola.com

# ── Gemini AI ─────────────────────────────────────────────────
GEMINI_API_KEY=""

# ── Blog Automation ──────────────────────────────────────────
CRON_SECRET=""               # Vercel Cron lo envía como `Authorization: Bearer <secret>` automáticamente
BLOG_CRON_SECRET=""          # Para disparar manualmente: header `x-cron-secret: <secret>`

# ── Telegram Bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""        # Token del bot de Telegram (BotFather)
TELEGRAM_OWNER_CHAT_ID=""    # Chat ID del dueño para recibir aprobaciones
TELEGRAM_WEBHOOK_SECRET=""   # Secret validado en el header X-Telegram-Bot-Api-Secret-Token

# ── Twilio / WhatsApp (Fase 3) ────────────────────────────────
# Descomentar cuando se implemente el bot de WhatsApp
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM=""    # formato: whatsapp:+34XXXXXXXXX
